{
  "name": "light-red",
  "displayName": "Crimson Red",
  "description": "Crimson-accented light and dark themes for VS Code, with regular and italic variants.",
  "version": "0.0.32",
  "publisher": "PChin",
  "icon": "Icon.png",
  "keywords": [
    "theme",
    "crimson",
    "red",
    "light",
    "dark",
    "italic"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "scripts": {
    "build": "node build-themes.js"
  },
  "contributes": {
    "themes": [
      {
        "label": "Crimson Red Light",
        "uiTheme": "vs",
        "path": "./themes/crimson-red-light-theme.json"
      },
      {
        "label": "Crimson Red Light Italic",
        "uiTheme": "vs",
        "path": "./themes/crimson-red-light-italic-theme.json"
      },
      {
        "label": "Crimson Red Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/crimson-red-dark-theme.json"
      },
      {
        "label": "Crimson Red Dark Italic",
        "uiTheme": "vs-dark",
        "path": "./themes/crimson-red-dark-italic-theme.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pchinnasamy/vscode-crimson-theme.git"
  }
}